# Placement Readiness Copilot - Environment Configuration Example
# Copy this file to .env and configure for your local or production environment.

# Environment mode: 'development', 'test', or 'production'
# In production, SECRET_KEY MUST be explicitly configured or the server will refuse to start.
APP_ENV=development

# JWT Secret Key (required in production; auto-generated in development if omitted)
# Generate a secure key using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Never commit real production secret keys or use deprecated dev fallback keys.
SECRET_KEY=

# Database configuration
DATABASE_URL=sqlite:///backend/data/career_copilot.db

# Feature flags
ENABLE_MOCK_INTERVIEW=false

# LLM Provider selection ('ollama', 'mock', 'gemini', 'openai', 'claude')
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://10.134.74.60:11434

# Provider Concurrency Limits
LLM_CONCURRENCY_OLLAMA=1
LLM_CONCURRENCY_OPENAI=10
LLM_CONCURRENCY_CLAUDE=10
LLM_CONCURRENCY_GEMINI=10
LLM_CONCURRENCY_MOCK=10

# Per-student review rate limits
RATE_LIMIT_REVIEWS_PER_HOUR=10
RATE_LIMIT_WINDOW_SECONDS=3600
